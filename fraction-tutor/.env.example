# Tutor proxy URL. Handles both LLM safety-net hints and TTS.
# Real API keys (Anthropic, ElevenLabs) live on the Worker side
# (../proxy) as Cloudflare secrets — they never reach the browser.
#
# Local dev:
#   VITE_TUTOR_API_URL=http://localhost:8787
# Production:
#   VITE_TUTOR_API_URL=https://<your-worker>.<account>.workers.dev
VITE_TUTOR_API_URL=

# Voice ID (not a secret). The worker has a default if this is empty.
# Find more voice IDs at https://elevenlabs.io/app/voice-library.
# Examples:
#   NoOVOzCQFLOvtsMoNcdT  Lila (current default)
#   g14YnDYCsy3k7XLlcKlO  Todd
#   21m00Tcm4TlvDq8ikWAM  Rachel
#   EXAVITQu4vr4xnSDxMaL  Sarah (soft, gentle)
#   pNInz6obpgDQGcFmaJgB  Adam
VITE_ELEVENLABS_VOICE_ID=NoOVOzCQFLOvtsMoNcdT
