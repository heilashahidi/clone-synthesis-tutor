# ElevenLabs text-to-speech.
# Get a key at https://elevenlabs.io/app/settings/api-keys.
# WARNING: VITE_-prefixed env vars are bundled into the client JS
# and visible to anyone who opens the app. Fine for local dev; for
# production, route requests through a proxy that holds the key.

VITE_ELEVENLABS_API_KEY=

# Optional. Default is Lila.
# Find more voice IDs at https://elevenlabs.io/app/voice-library.
# Examples:
#   NoOVOzCQFLOvtsMoNcdT  Lila (current default)
#   g14YnDYCsy3k7XLlcKlO  Todd
#   21m00Tcm4TlvDq8ikWAM  Rachel
#   EXAVITQu4vr4xnSDxMaL  Sarah (soft, gentle)
#   pNInz6obpgDQGcFmaJgB  Adam
VITE_ELEVENLABS_VOICE_ID=NoOVOzCQFLOvtsMoNcdT

# Optional: LLM safety net proxy.
# When set, the lesson runner will call this endpoint on
# `wait_for_action` nodes that have `llmFallthrough: true`, 15s
# after the scripted hint fires. The proxy is expected to accept
# POST /tutor with { system, user } and return { text }. Leaving
# this unset disables the LLM second-chance hint; the lesson runs
# entirely on the scripted script.
# Example: VITE_TUTOR_API_URL=http://localhost:8787
VITE_TUTOR_API_URL=
