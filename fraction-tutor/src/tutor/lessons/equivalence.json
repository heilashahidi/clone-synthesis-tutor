{
  "id": "fraction-equivalence-1",
  "title": "Same size, different pieces",
  "startNode": "lesson_intro",
  "nodes": {

    "lesson_intro": {
      "id": "lesson_intro",
      "type": "message",
      "message": "Today we're going to discover a secret about fractions. Ready?",
      "next": "intro_1"
    },

    "intro_1": {
      "id": "intro_1",
      "type": "message",
      "message": "See this bar? It's one whole piece.",
      "next": "intro_shade_teach",
      "setup": {
        "bars": [
          { "segments": 1, "shaded": 0, "color": "teal" }
        ]
      }
    },
    "intro_shade_teach": {
      "id": "intro_shade_teach",
      "type": "wait_for_action",
      "message": "Tap it to color it in!",
      "condition": {
        "type": "fraction_equals",
        "barIndex": 0,
        "target": { "numerator": 1, "denominator": 1 }
      },
      "onMet": "intro_shade_confirm",
      "hint": "Just tap the bar once to color it.",
      "hintDelay": 8,
      "allowedActions": ["SHADE"]
    },
    "intro_shade_confirm": {
      "id": "intro_shade_confirm",
      "type": "message",
      "message": "Nice! You colored the whole bar — that's 1 out of 1, or 1/1.",
      "next": "split_intro_1"
    },

    "split_intro_1": {
      "id": "split_intro_1",
      "type": "message",
      "message": "Now watch — I'm splitting it into 2 equal pieces.",
      "next": "split_intro_2",
      "setup": {
        "bars": [
          { "segments": 2, "shaded": 1, "color": "teal" }
        ]
      }
    },
    "split_intro_2": {
      "id": "split_intro_2",
      "type": "prompt",
      "message": "One piece is colored, one isn't. That's 1 out of 2 — we call it 1/2. Make sense?",
      "options": [
        { "label": "Got it!", "next": "build_half_confirm" },
        { "label": "I think so", "next": "build_half_confirm" },
        { "label": "Not really", "next": "split_explain" }
      ]
    },
    "split_explain": {
      "id": "split_explain",
      "type": "message",
      "message": "The bar has 2 pieces. 1 is colored. So that's 1 out of 2 — or 1/2!",
      "next": "build_half_confirm"
    },
    "build_half_confirm": {
      "id": "build_half_confirm",
      "type": "message",
      "message": "Good — the top bar shows 1/2. Now here's the big question…",
      "next": "equiv_challenge_1"
    },

    "equiv_challenge_1": {
      "id": "equiv_challenge_1",
      "type": "message",
      "message": "Here's a second bar. Can you make it show 2/4?",
      "next": "equiv_wait_1",
      "setup": {
        "bars": [
          { "segments": 2, "shaded": 1, "color": "teal" },
          { "segments": 1, "shaded": 0, "color": "blue" }
        ]
      }
    },
    "equiv_wait_1": {
      "id": "equiv_wait_1",
      "type": "wait_for_action",
      "message": "Tap a piece twice quickly to split it in half. Keep splitting until you have 4 pieces, then tap 2 to color them.",
      "condition": {
        "type": "fraction_equals",
        "barIndex": 1,
        "target": { "numerator": 2, "denominator": 4 }
      },
      "onMet": "equiv_reveal_1",
      "hint": "Double-tap pieces to split them. Then single-tap to color.",
      "hintDelay": 15,
      "llmFallthrough": true,
      "allowedActions": ["SPLIT", "SHADE", "COMBINE"]
    },
    "equiv_reveal_1": {
      "id": "equiv_reveal_1",
      "type": "message",
      "message": "You made 2/4! Now look at both bars — the colored parts are the same size.",
      "next": "equiv_question_1"
    },
    "equiv_question_1": {
      "id": "equiv_question_1",
      "type": "prompt",
      "message": "1/2 and 2/4 take up the same space. What does that mean?",
      "options": [
        { "label": "They're equal!", "next": "equiv_confirm_1", "isCorrect": true },
        { "label": "2/4 is bigger?", "next": "equiv_misconception_1" },
        { "label": "I'm not sure", "next": "equiv_hint_1" }
      ]
    },
    "equiv_confirm_1": {
      "id": "equiv_confirm_1",
      "type": "message",
      "message": "Yes! 1/2 and 2/4 are the same amount. More pieces doesn't mean more — it means smaller pieces!",
      "next": "equiv_challenge_2_setup"
    },
    "equiv_misconception_1": {
      "id": "equiv_misconception_1",
      "type": "message",
      "message": "2 and 4 are bigger numbers, but look at the bars. The colored parts are the same size! Smaller pieces, just more of them.",
      "next": "equiv_confirm_1"
    },
    "equiv_hint_1": {
      "id": "equiv_hint_1",
      "type": "message",
      "message": "Look at where the color ends on each bar. They line up! Same space means same amount.",
      "next": "equiv_confirm_1"
    },

    "equiv_challenge_2_setup": {
      "id": "equiv_challenge_2_setup",
      "type": "message",
      "message": "Let's try another! The top bar shows 2/3. Can you make the bottom bar equal to it?",
      "next": "equiv_wait_2",
      "setup": {
        "bars": [
          { "segments": 3, "shaded": 2, "color": "coral" },
          { "segments": 1, "shaded": 0, "color": "purple" }
        ]
      }
    },
    "equiv_wait_2": {
      "id": "equiv_wait_2",
      "type": "wait_for_action",
      "message": "Make the purple bar equal to 2/3. Try 4 out of 6!",
      "condition": {
        "type": "fraction_equals",
        "barIndex": 1,
        "target": { "numerator": 2, "denominator": 3 }
      },
      "onMet": "equiv_reveal_2",
      "hint": "Split pieces until you have 6, then color 4 of them.",
      "hintDelay": 20,
      "llmFallthrough": true,
      "allowedActions": ["SPLIT", "SHADE", "COMBINE"]
    },
    "equiv_reveal_2": {
      "id": "equiv_reveal_2",
      "type": "message",
      "message": "The colored parts line up again! You found another match.",
      "next": "equiv_question_2"
    },
    "equiv_question_2": {
      "id": "equiv_question_2",
      "type": "prompt",
      "message": "Do you see a pattern when we make equal fractions?",
      "options": [
        { "label": "More pieces, same colored amount", "next": "pattern_confirm", "isCorrect": true },
        { "label": "The numbers get bigger", "next": "pattern_redirect" },
        { "label": "Not sure yet", "next": "pattern_explain" }
      ]
    },
    "pattern_confirm": {
      "id": "pattern_confirm",
      "type": "message",
      "message": "That's it! More pieces, but smaller ones — so the colored amount stays the same.",
      "next": "non_example_setup"
    },
    "pattern_redirect": {
      "id": "pattern_redirect",
      "type": "message",
      "message": "The numbers do get bigger. But look — the colored part stays the same size. That's the key!",
      "next": "pattern_confirm"
    },
    "pattern_explain": {
      "id": "pattern_explain",
      "type": "message",
      "message": "The top bar has big pieces. The bottom has small pieces. But the colored parts are the same length!",
      "next": "non_example_setup"
    },

    "non_example_setup": {
      "id": "non_example_setup",
      "type": "message",
      "message": "Now — is 1/2 the same as 1/3? Let's check.",
      "next": "non_example_reveal",
      "setup": {
        "bars": [
          { "segments": 2, "shaded": 1, "color": "teal" },
          { "segments": 3, "shaded": 1, "color": "coral" }
        ]
      }
    },
    "non_example_reveal": {
      "id": "non_example_reveal",
      "type": "prompt",
      "message": "Do these colored parts take up the same space?",
      "options": [
        { "label": "No — 1/2 is bigger!", "next": "non_example_correct", "isCorrect": true },
        { "label": "They look the same?", "next": "non_example_incorrect" },
        { "label": "1/3 is bigger?", "next": "non_example_misconception" }
      ]
    },
    "non_example_correct": {
      "id": "non_example_correct",
      "type": "message",
      "message": "Right! The colored parts don't line up — so they're not equal. The bars don't lie!",
      "next": "assessment_intro"
    },
    "non_example_incorrect": {
      "id": "non_example_incorrect",
      "type": "message",
      "message": "Look where the color ends on each bar. The teal one goes further — 1/2 is more than 1/3.",
      "next": "non_example_correct"
    },
    "non_example_misconception": {
      "id": "non_example_misconception",
      "type": "message",
      "message": "3 is bigger than 2, but more pieces means smaller pieces. So 1 out of 3 is less than 1 out of 2!",
      "next": "non_example_correct"
    },

    "assessment_intro": {
      "id": "assessment_intro",
      "type": "message",
      "message": "Let's see what you've learned! Three quick questions.",
      "next": "quiz_1"
    },
    "quiz_1": {
      "id": "quiz_1",
      "type": "check",
      "message": "Which fraction equals 1/2?",
      "options": [
        { "label": "2/3", "next": "quiz_1_wrong", "isCorrect": false },
        { "label": "3/6", "next": "quiz_1_right", "isCorrect": true },
        { "label": "1/4", "next": "quiz_1_wrong", "isCorrect": false }
      ],
      "correctNext": "quiz_1_right",
      "correctMessage": "Yes! 3/6 equals 1/2.",
      "incorrectNext": "quiz_1_wrong",
      "incorrectMessage": "Not quite — check the bars."
    },
    "quiz_1_right": {
      "id": "quiz_1_right",
      "type": "message",
      "message": "3 out of 6 is the same as 1 out of 2. Look — they line up!",
      "next": "quiz_2",
      "setup": {
        "bars": [
          { "segments": 2, "shaded": 1, "color": "teal" },
          { "segments": 6, "shaded": 3, "color": "blue" }
        ]
      }
    },
    "quiz_1_wrong": {
      "id": "quiz_1_wrong",
      "type": "message",
      "message": "Look — 1/2 and 3/6 line up perfectly. 3 out of 6 is the same as 1 out of 2!",
      "next": "quiz_2",
      "setup": {
        "bars": [
          { "segments": 2, "shaded": 1, "color": "teal" },
          { "segments": 6, "shaded": 3, "color": "blue" }
        ]
      }
    },

    "quiz_2": {
      "id": "quiz_2",
      "type": "check",
      "message": "Which fraction equals 2/3?",
      "options": [
        { "label": "4/6", "next": "quiz_2_right", "isCorrect": true },
        { "label": "2/6", "next": "quiz_2_wrong", "isCorrect": false },
        { "label": "3/4", "next": "quiz_2_wrong", "isCorrect": false }
      ],
      "correctNext": "quiz_2_right",
      "correctMessage": "Yes! 4/6 equals 2/3.",
      "incorrectNext": "quiz_2_wrong",
      "incorrectMessage": "Not quite — look at the bars."
    },
    "quiz_2_right": {
      "id": "quiz_2_right",
      "type": "message",
      "message": "4 out of 6 matches 2 out of 3. You're getting good at this!",
      "next": "quiz_3",
      "setup": {
        "bars": [
          { "segments": 3, "shaded": 2, "color": "coral" },
          { "segments": 6, "shaded": 4, "color": "purple" }
        ]
      }
    },
    "quiz_2_wrong": {
      "id": "quiz_2_wrong",
      "type": "message",
      "message": "See the bars — 4 out of 6 lines up with 2 out of 3. Each top piece equals two bottom pieces!",
      "next": "quiz_3",
      "setup": {
        "bars": [
          { "segments": 3, "shaded": 2, "color": "coral" },
          { "segments": 6, "shaded": 4, "color": "purple" }
        ]
      }
    },

    "quiz_3": {
      "id": "quiz_3",
      "type": "check",
      "message": "Last one! Are 2/4 and 3/4 equal?",
      "options": [
        { "label": "Yes, they're equal", "next": "quiz_3_wrong", "isCorrect": false },
        { "label": "No, they're different", "next": "quiz_3_right", "isCorrect": true }
      ],
      "correctNext": "quiz_3_right",
      "correctMessage": "Right! Different amounts colored.",
      "incorrectNext": "quiz_3_wrong",
      "incorrectMessage": "Look at the colored parts."
    },
    "quiz_3_right": {
      "id": "quiz_3_right",
      "type": "message",
      "message": "2 colored vs 3 colored — different amounts, not equivalent!",
      "next": "complete",
      "setup": {
        "bars": [
          { "segments": 4, "shaded": 2, "color": "teal" },
          { "segments": 4, "shaded": 3, "color": "blue" }
        ]
      }
    },
    "quiz_3_wrong": {
      "id": "quiz_3_wrong",
      "type": "message",
      "message": "2 colored pieces vs 3 — that's different amounts, so they're not equal!",
      "next": "complete",
      "setup": {
        "bars": [
          { "segments": 4, "shaded": 2, "color": "teal" },
          { "segments": 4, "shaded": 3, "color": "blue" }
        ]
      }
    },

    "complete": {
      "id": "complete",
      "type": "message",
      "message": "You did it! If the colored parts line up, the fractions are equal. Great job today!"
    }
  }
}
